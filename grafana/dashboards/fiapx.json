{
  "uid": "fiapx-overview",
  "title": "FIAP X — Processamento de vídeos",
  "tags": ["fiapx"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Vídeos em processamento agora",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 8 }] } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
          "expr": "sum(fiapx_worker_videos_in_flight)",
          "legendFormat": "em voo"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fila de processamento",
      "description": "Mensagens aguardando um worker. É esta série que mostra o sistema absorvendo picos sem perder requisição.",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 50 }] } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
          "expr": "sum(rabbitmq_queue_messages_ready{queue=\"video-processing-queue\"})",
          "legendFormat": "pendentes"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Uploads recebidos",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
          "expr": "sum(rate(fiapx_video_uploads_total[5m])) * 60",
          "legendFormat": "uploads/min"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Vídeos por desfecho",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
          "expr": "sum by (outcome) (rate(fiapx_worker_videos_total[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Duração do processamento (p50 e p95)",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fiapx_worker_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fiapx_worker_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latência da API por rota (p95)",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(fiapx_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Notificações de falha",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
          "expr": "sum by (outcome) (rate(fiapx_notification_messages_total[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Profundidade das filas",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
          "expr": "sum by (queue) (rabbitmq_queue_messages_ready)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Transições de estado persistidas",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
          "expr": "sum by (status) (rate(fiapx_video_status_transitions_total[5m])) * 60",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
