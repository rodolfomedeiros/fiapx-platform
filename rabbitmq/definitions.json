{
  "rabbit_version": "4.0.0",
  "rabbitmq_version": "4.0.0",
  "users": [
    {
      "name": "fiapx",
      "password": "fiapx",
      "tags": ["administrator"]
    }
  ],
  "vhosts": [{ "name": "/" }],
  "permissions": [
    {
      "user": "fiapx",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "video.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "video-processing-queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "video.events",
        "x-dead-letter-routing-key": "video.failed"
      }
    },
    {
      "name": "video-status-queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "video-processing-dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "video.events",
      "vhost": "/",
      "destination": "video-processing-queue",
      "destination_type": "queue",
      "routing_key": "video.received",
      "arguments": {}
    },
    {
      "source": "video.events",
      "vhost": "/",
      "destination": "video-status-queue",
      "destination_type": "queue",
      "routing_key": "video.status.changed",
      "arguments": {}
    },
    {
      "source": "video.events",
      "vhost": "/",
      "destination": "video-processing-dlq",
      "destination_type": "queue",
      "routing_key": "video.failed",
      "arguments": {}
    }
  ],
  "policies": [],
  "parameters": [],
  "global_parameters": [],
  "topic_permissions": []
}
